{
  "name": "ai-sdk-provider-martllm",
  "version": "0.1.0",
  "description": "MartLLM provider for the Vercel AI SDK: hundreds of chat models and image models with one OpenAI-compatible API key.",
  "license": "MIT",
  "author": "AL Global LLC <support@uberllm.dev>",
  "homepage": "https://martllm.com/docs/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-global-tech/ai-sdk-provider-uberllm.git"
  },
  "bugs": {
    "url": "https://github.com/al-global-tech/ai-sdk-provider-uberllm/issues"
  },
  "keywords": [
    "martllm",
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "llm",
    "openai-compatible",
    "provider",
    "deepseek",
    "claude",
    "gemini"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "prepare": "tsup"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/provider": "^4.0.37",
    "@ai-sdk/provider-utils": "^5.0.79"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.170",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
